# Example environment configuration for FrontendContainer
# Copy this file to .env and adjust values as needed.

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL
# Base URL for backend API used by the frontend.
REACT_APP_API_BASE_URL=https://kavia-alb-699c693e-2016998426.backend.kavia.app/

# PUBLIC_INTERFACE
# REACT_APP_STATUS_MONITORING_ENABLED
# When set to "false", the UI hides status indicators and disables ping actions.
REACT_APP_STATUS_MONITORING_ENABLED=true
